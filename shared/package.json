{
  "name": "shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Types and constants shared by the API and the web app (single source of truth)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
