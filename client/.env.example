# Copy to .env.local for local overrides. Vite also reads .env.development and .env.production
# automatically depending on the command (`vite` vs `vite build`).
#
# API base URL. Leave unset to use "/api": in dev Vite proxies it to the Express server on :4000,
# in production put the API behind the same domain (reverse proxy).
# Set a full URL only when the API lives on another origin (and add it to the API's CORS_ORIGIN).
# VITE_API_URL=https://api.example.com/api

# Per-request timeout in milliseconds (default 10000)
# VITE_API_TIMEOUT_MS=10000

# Log request timings in the console. Always on in development builds.
# VITE_LOG_REQUESTS=false
