# Copy to .env (loaded by the server via node --env-file)
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/task-manager
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (0 = none, 1 = one load balancer)
TRUST_PROXY=0
# Serve API docs at /api/docs (default: on, except when NODE_ENV=production)
# API_DOCS=true
# Log verbosity: fatal | error | warn | info | debug | trace | silent (default: debug in dev, info in prod, silent in tests)
# LOG_LEVEL=info
# Human-readable coloured logs instead of JSON (default: on in development only)
# LOG_PRETTY=false
# Seconds-level cache for GET /api/tasks/stats, in milliseconds (0 disables). Per instance.
# STATS_CACHE_TTL_MS=5000
